     gpio[LIMITS_PORT0].irq_state.mask = 0;
 
@@ -246,6 +336,10 @@ static control_signals_t systemGetState (void)
 
     signals.mask = gpio[CONTROL_PORT].state.value;
 	signals.limits_override = settings.control_invert.limits_override;
+#if VIRTUAL_MACHINE
+    signals.limits_override = Off;
+    return signals;
+#endif
 
     if(settings.control_invert.mask)
         signals.mask ^= settings.control_invert.mask;
@@ -255,6 +349,14 @@ static control_signals_t systemGetState (void)
 
 static void probeConfigureInvertMask (bool is_probe_away, bool probing)
 {
+#if VIRTUAL_MACHINE
+  if(!vm_ready)
+      vm_init();
+  for(uint_fast8_t i = 0; i < N_AXIS; i++)
+      vm_probe_start[i] = vm_steps[i];
+  vm_probe_away = is_probe_away;
+  vm_probing = probing;
+#endif
   probe_invert = settings.probe.invert_probe_pin;
 
   if (is_probe_away)
@@ -268,6 +370,12 @@ probe_state_t probeGetState (void)
 
     state.value = mcu_gpio_get(&gpio[PROBE_PORT], PROBE_MASK);
 
+#if VIRTUAL_MACHINE
+    state.connected = On;
+    state.triggered = vm_probe_contact() != vm_probe_away;
+    return state;
+#endif
+
     state.triggered ^= probe_invert;
 
     return state;
