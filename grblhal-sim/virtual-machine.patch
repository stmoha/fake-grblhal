--- a/src/driver.c
+++ b/src/driver.c
@@ -55,6 +55,83 @@ static axes_signals_t motors_0 = {AXES_BITMASK}, motors_1 = {AXES_BITMASK};
 void Limits1_IRQHandler (void);
 #endif
 
+
+#ifndef VIRTUAL_MACHINE
+#define VIRTUAL_MACHINE 0
+#endif
+
+#if VIRTUAL_MACHINE
+/*
+ * Virtual machine (fake-grblhal): a physical position for each motor, counted from the
+ * step pulses, with a limit switch at the homing end of X, Y and Z (from $23) and at the
+ * far end of travel ($130-$132), and a probe that touches 3 mm into any probing move.
+ * Inputs are reported as already-corrected (logical) states, so the invert settings
+ * ($5, $6, $14 ...) of the machine being copied don't make them read backwards.
+ */
+#include <math.h>
+static volatile int32_t vm_steps[N_AXIS];
+static volatile uint32_t vm_dir;
+static volatile bool vm_ready = false, vm_probing = false, vm_probe_away = false;
+static int32_t vm_probe_start[N_AXIS];
+static uint32_t vm_layout = 0xFFFFFFFF; // $23 the switches were placed for
+
+static void vm_init (void)
+{
+    for(uint_fast8_t i = 0; i < N_AXIS; i++) {
+        float spm = settings.axis[i].steps_per_mm;
+        bool home_neg = (settings.homing.dir_mask.mask >> i) & 1;
+        vm_steps[i] = i < 3 ? (int32_t)lroundf((home_neg ? 20.0f : -20.0f) * spm) : 0;
+    }
+    vm_layout = settings.homing.dir_mask.mask;
+    vm_ready = true;
+}
+
+static uint16_t vm_limit_bits (void)
+{
+    uint16_t bits = 0;
+    if(!vm_ready)
+        return 0;
+    for(uint_fast8_t i = 0; i < N_AXIS && i < 3; i++) {
+        if((settings.steppers.is_rotary.mask >> i) & 1)
+            continue;
+        float spm = settings.axis[i].steps_per_mm, travel = fabsf(settings.axis[i].max_travel);
+        float pos = (float)vm_steps[i] / spm;
+        bool home_neg = (settings.homing.dir_mask.mask >> i) & 1;
+        bool hit = home_neg ? (pos <= 0.0f || pos >= travel + 3.0f) : (pos >= 0.0f || pos <= -(travel + 3.0f));
+        if(hit)
+            bits |= (1 << i);
+    }
+    return bits;
+}
+
+static void vm_step (axes_signals_t step_out)
+{
+    // Changing $23 (which way each axis homes) moves the virtual switches with it:
+    // the machine starts again 20 mm from its switches, not homed.
+    if(!vm_ready || vm_layout != settings.homing.dir_mask.mask)
+        vm_init();
+    for(uint_fast8_t i = 0; i < N_AXIS; i++) {
+        if(step_out.bits & (1 << i))
+            vm_steps[i] += (vm_dir & (1 << i)) ? -1 : 1;
+    }
+    uint16_t bits = vm_limit_bits();
+    if((gpio[LIMITS_PORT0].state.value & AXES_BITMASK) != bits)
+        mcu_gpio_in(&gpio[LIMITS_PORT0], bits, AXES_BITMASK);
+}
+
+static bool vm_probe_contact (void)
+{
+    if(!vm_probing)
+        return false;
+    for(uint_fast8_t i = 0; i < N_AXIS; i++) {
+        float moved = fabsf((float)(vm_steps[i] - vm_probe_start[i]) / settings.axis[i].steps_per_mm);
+        if(moved >= 3.0f)
+            return true;
+    }
+    return false;
+}
+#endif
+
 status_code_t mc_rigid_tapping (plan_line_data_t *pl_data, coord_data_t *target, coord_data_t *position, float pitch, float rpm_multiplier)
 {
     return Status_GcodeUnsupportedCommand; // TBC
@@ -110,6 +187,9 @@ inline static void set_step_outputs (axes_signals_t step_out)
 
 inline static void set_dir_outputs (axes_signals_t dir_out)
 {
+#if VIRTUAL_MACHINE
+    vm_dir = dir_out.value;
+#endif
     mcu_gpio_set(&gpio[DIR_PORT], dir_out.value ^ settings.steppers.dir_invert.mask, AXES_BITMASK);
 }
 
@@ -160,6 +240,9 @@ static void stepperPulseStart (stepper_t *stepper)
 
     if(stepper->step_out.bits) {
         set_step_outputs(stepper->step_out);
+#if VIRTUAL_MACHINE
+        vm_step(stepper->step_out);
+#endif
     }
 }
 
